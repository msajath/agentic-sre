# Copy to deploy/.env on the VPS and restrict it to the deployment account (chmod 600).
# Use the exact tag published by the version-tag GitHub Actions run.
SRE_IMAGE_BASE=ghcr.io/msajath/agentic-sre
SRE_IMAGE_TAG=v0.1.0
SRE_HOST_PORT=8000

# Fill these privately; the database URL must contain the same URL-safe password.
SECRET_KEY=
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=
BOOTSTRAP_ADMIN_PASSWORD=

# Match the HTTPS origin served by your reverse proxy.
ALLOWED_ORIGINS=["https://sre.example.com"]
SIMULATION_ENABLED=true
# Optional narration needs a reachable trusted HTTPS proxy for Ollama.
DOCKER_OLLAMA_BASE_URL=https://ollama.example.internal
OLLAMA_MODEL=llama3.1
