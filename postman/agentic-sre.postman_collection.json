          }
        ],
        "url": "{{baseUrl}}/api/v1/remediation/plans/{{rejectPlanId}}/reject",
        "body": {
          "mode": "raw",
          "raw": "{\"reason\": \"Insufficient current evidence to approve\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Admin rejects plan returns 200\", () => pm.response.to.have.status(200));",
              "pm.test('rejection persisted', () => pm.expect(pm.response.json().state).to.eql('REJECTED'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit chain verifies",
