            "exec": [
              "pm.test(\"Legacy archive endpoint returns 200\", () => pm.response.to.have.status(200));",
              "pm.test('legacy history labeled unverified', () => pm.expect(pm.response.json().verified).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
