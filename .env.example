# Configure these in your environment or a private .env file for Docker Compose.
# Never commit actual secrets. Use a password manager or random generator.
SECRET_KEY=
BOOTSTRAP_ADMIN_PASSWORD=
ENVIRONMENT=production
# Local PostgreSQL connection shared by the API and Prisma (URL-encode password characters).
DATABASE_URL=postgresql://agentic_sre:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:55432/agentic_sre
# Required when running tests; use a dedicated database with the _test suffix.
TEST_DATABASE_URL=postgresql://agentic_sre:REPLACE_WITH_URL_SAFE_PASSWORD@127.0.0.1:55432/agentic_sre_test
# Docker uses a separate server; local and Docker databases do not share records.
POSTGRES_PASSWORD=
DOCKER_DATABASE_URL=postgresql://agentic_sre:REPLACE_WITH_URL_SAFE_PASSWORD@postgres:5432/agentic_sre
SRE_DEBUG=false
SRE_HOST_PORT=8000
SIMULATION_ENABLED=true
# JSON array of the browser origins that will use the API/WebSocket.
ALLOWED_ORIGINS=["http://localhost:8000"]
# Production inference endpoints must use HTTPS. Configure a trusted TLS proxy
# in front of Ollama rather than exposing its unauthenticated HTTP API.
OLLAMA_BASE_URL=https://ollama.example.internal
# Docker production uses this independent value so a local HTTP Ollama setting
# cannot prevent the production container from starting.
DOCKER_OLLAMA_BASE_URL=https://ollama.example.internal
OLLAMA_MODEL=llama3.1
